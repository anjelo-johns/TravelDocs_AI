SECRET_KEY=replace-with-a-random-secret
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# ========================================================
# MICROSOFT AZURE AI FOUNDRY / AZURE OPENAI CONFIGURATION
# ========================================================
# Option 1: Microsoft Azure AI Foundry (Project / Model Catalog / Serverless)
#   Portal: https://ai.azure.com/ -> Project -> Models + endpoints
#   Endpoint: https://<your-project>.services.ai.azure.com/models
#         or: https://<deployment-name>.<region>.models.ai.azure.com
#
# Option 2: Azure OpenAI Service
#   Portal: https://portal.azure.com/ -> Azure OpenAI -> Keys and Endpoint
#   Endpoint: https://<your-resource>.openai.azure.com/
# ========================================================

MODEL_PROVIDER=azure_ai_foundry
MODEL_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.services.ai.azure.com/models
MODEL_DEPLOYMENT=YOUR-MODEL-DEPLOYMENT
MODEL_API_KEY=YOUR-AZURE-AI-FOUNDRY-KEY
MODEL_API_VERSION=2024-10-21
